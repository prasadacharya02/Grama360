NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local-only credentials from docker-compose.yml. Replace for deployed environments.
DATABASE_URL=postgres://grama360:grama360_dev_only@localhost:5432/grama360
DATABASE_SSL=false

# Firebase Admin validates mobile ID tokens. Use Application Default Credentials
# locally or workload identity in production; never commit a service-account key.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
